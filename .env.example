# =============================================================================
# DMARK-HOLE - Environment Configuration
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://dmark:dmark@localhost:5432/dmark_hole?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGIN=http://localhost:5173
API_TRUST_PROXY=false

# --- Authentication ---
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=change-me-to-another-random-string

# --- Encryption ---
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key
CREDENTIALS_ENCRYPTION_KEY=change-me-to-a-different-32-byte-hex-key

# --- Ingestion ---
INGESTION_INTERVAL_MS=300000
INGESTION_CONCURRENCY=5
INGESTION_RATE_LIMIT_PER_MINUTE=30
MAX_ATTACHMENT_SIZE_MB=25
MAX_XML_SIZE_MB=50

# --- Email (for alert notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dmark-hole.local

# --- Integrations ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=

# --- External APIs ---
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
LOG_FORMAT=json

# --- Web Frontend ---
WEB_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001

# --- Docker ---
COMPOSE_PROJECT_NAME=dmark-hole
POSTGRES_USER=dmark
POSTGRES_PASSWORD=dmark
POSTGRES_DB=dmark_hole
