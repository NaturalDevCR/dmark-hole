# =============================================================================
# DMARK-HOLE - environment configuration
# =============================================================================
# Every variable is optional. Defaults shown. For systemd installs this file is
# copied to /etc/dmark-hole/dmark-hole.env; for `pnpm dev` copy it to ./.env.
# Use plain KEY=value lines (no quotes, no `export`) so systemd can read it.

# --- Storage -----------------------------------------------------------------
# Directory holding the SQLite database and the auto-generated secret.
# Docker: /data   systemd: /var/lib/dmark-hole   dev: ./data
# DATA_DIR=./data

# --- HTTP server -------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Set to true when running behind a reverse proxy (trusts X-Forwarded-*).
TRUST_PROXY=false
# Set to true when the UI is served over HTTPS (adds the Secure cookie flag).
SECURE_COOKIES=false
# Directory with the built web UI. Only override for custom layouts.
# WEB_DIST=

# --- Secrets -----------------------------------------------------------------
# Signs sessions and encrypts stored credentials (IMAP passwords, ...).
# Minimum 32 chars. If empty, a random one is generated in DATA_DIR/.secret.
# Generate one with: openssl rand -base64 48
SECRET_KEY=

# --- Bootstrap admin (optional) ------------------------------------------------
# If both are set, the admin is created on first start. Otherwise the first-run
# setup page in the UI asks for it.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Built-in SMTP receiver (for rua/ruf mails) ---------------------------------
# Can also be toggled from the UI (Settings).
SMTP_ENABLED=false
# Required for the SMTP receiver: accepted RCPT TO addresses, comma separated.
# Use full addresses or "@domain". Can also be edited in the UI.
# SMTP_ALLOWED_RECIPIENTS=dmarc@reports.example.com
# Port to listen on. 2525 needs no privileges; use 25 on systemd installs
# (the unit grants CAP_NET_BIND_SERVICE) or map 25 -> 2525 in Docker.
SMTP_PORT=2525
SMTP_LISTEN_HOST=0.0.0.0
# Maximum accepted message size in MB.
SMTP_MAX_SIZE_MB=25
# Optional STARTTLS: paths to a PEM key and certificate readable by the app.
SMTP_TLS_KEY=
SMTP_TLS_CERT=

# --- Background jobs -----------------------------------------------------------
# Set to true to disable the scheduler (IMAP polling, DNS checks, alerts).
DISABLE_SCHEDULER=false
