generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// AUTH & ORGANIZATIONS
// =============================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  active    Boolean  @default(true)
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         User[]
  domains       Domain[]
  mailboxes     Mailbox[]
  alerts        Alert[]
  integrations  Integration[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  notificationRules NotificationRule[]

  @@map("organizations")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
  MSP
}

model User {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  email          String       @unique
  passwordHash   String       @map("password_hash")
  name           String
  role           UserRole     @default(READER)
  active         Boolean      @default(true)
  lastLoginAt    DateTime?    @map("last_login_at")
  settings       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  sessions     Session[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  ANALYST
  READER
  API
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  token        String   @unique
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ip           String?
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model ApiKey {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  key            String   @unique
  hash           String
  scopes         String[]
  lastUsedAt     DateTime? @map("last_used_at")
  expiresAt      DateTime? @map("expires_at")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([key])
  @@map("api_keys")
}

// =============================================================================
// DOMAINS & DNS MONITORING
// =============================================================================

model Domain {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  domain         String   @unique
  displayName    String?  @map("display_name")
  verified       Boolean  @default(false)
  active         Boolean  @default(true)
  monitoringMode MonitoringMode @default(MANUAL) @map("monitoring_mode")
  tags           String[]
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization      Organization        @relation(fields: [organizationId], references: [id])
  dnsRecords        DnsRecord[]
  dnsSnapshots      DnsSnapshot[]
  reports           DmarcReport[]
  dmarcSummary      DmarcDailySummary[]
  alerts            Alert[]
  mailboxDomains    MailboxDomain[]
  threatIntel       ThreatIntel[]

  @@index([organizationId])
  @@map("domains")
}

enum MonitoringMode {
  MANUAL
  DAILY
  HOURLY
  REALTIME
}

model DnsRecord {
  id        String   @id @default(cuid())
  domainId  String   @map("domain_id")
  type      DnsRecordType
  host       String
  value     String
  ttl       Int?
  raw       Json?
  valid     Boolean
  errors    Json     @default("[]")
  checkedAt DateTime @default(now()) @map("checked_at")

  domain Domain @relation(fields: [domainId], references: [id])

  @@unique([domainId, type, host])
  @@map("dns_records")
}

enum DnsRecordType {
  SPF
  DKIM
  DMARC
  MX
  A
  AAAA
  PTR
  BIMI
  MTA_STS
  TLS_RPT
  TXT
  CNAME
}

model DnsSnapshot {
  id        String   @id @default(cuid())
  domainId  String   @map("domain_id")
  records   Json
  hash      String
  createdAt DateTime @default(now()) @map("created_at")

  domain Domain @relation(fields: [domainId], references: [id])

  @@index([domainId, createdAt])
  @@map("dns_snapshots")
}

// =============================================================================
// MAILBOXES & INGESTION
// =============================================================================

model Mailbox {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  email          String
  type           MailboxType
  config         Json
  active         Boolean      @default(true)
  lastSyncAt     DateTime?    @map("last_sync_at")
  lastError      String?
  syncStatus     SyncStatus   @default(PENDING) @map("sync_status")
  stats          Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  mailboxDomains  MailboxDomain[]
  ingestLogs      IngestLog[]

  @@map("mailboxes")
}

enum MailboxType {
  IMAP
  POP3
  MICROSOFT365
  GMAIL_API
  SMTP_RECEIVER
  WEBHOOK
}

enum SyncStatus {
  PENDING
  SYNCING
  OK
  ERROR
  RATE_LIMITED
}

model MailboxDomain {
  id        String @id @default(cuid())
  mailboxId String @map("mailbox_id")
  domainId  String @map("domain_id")

  mailbox Mailbox @relation(fields: [mailboxId], references: [id])
  domain  Domain  @relation(fields: [domainId], references: [id])

  @@unique([mailboxId, domainId])
  @@map("mailbox_domains")
}

model IngestLog {
  id        String    @id @default(cuid())
  mailboxId String    @map("mailbox_id")
  messageId String    @map("message_id")
  subject   String?
  from      String?
  success   Boolean
  stage     IngestStage
  error     String?
  durationMs Int?    @map("duration_ms")
  createdAt DateTime @default(now()) @map("created_at")

  mailbox Mailbox @relation(fields: [mailboxId], references: [id])

  @@index([mailboxId, createdAt])
  @@map("ingest_logs")
}

enum IngestStage {
  FETCH
  PARSE
  VALIDATE
  EXTRACT
  STORE
  DEDUP
  DONE
  FAILED
}

// =============================================================================
// DMARC REPORTS
// =============================================================================

model DmarcReport {
  id              String   @id @default(cuid())
  domainId        String   @map("domain_id")
  organizationId  String   @map("organization_id")
  reportId        String   @map("report_id")
  reportType      ReportType @default(AGGREGATE) @map("report_type")
  beginDate       DateTime @map("begin_date")
  endDate         DateTime @map("end_date")
  policyDomain    String   @map("policy_domain")
  policyAdkim     String   @default("r") @map("policy_adkim")
  policyAspf      String   @default("r") @map("policy_aspf")
  policyP         PolicyP
  policyPct       Int      @default(100) @map("policy_pct")
  policySp        PolicySp @default(NONE) @map("policy_sp")
  rawXml          String?  @map("raw_xml")
  rawXmlHash      String?  @map("raw_xml_hash")
  parsed          Boolean  @default(false)
  errorMessage    String?  @map("error_message")
  ingestedFrom    String?  @map("ingested_from")
  reportOrg       String?  @map("report_org")
  reportEmail     String?  @map("report_email")
  extraContactInfo String? @map("extra_contact_info")
  createdAt       DateTime @default(now()) @map("created_at")

  domain       Domain        @relation(fields: [domainId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  records      DmarcRecord[]

  @@unique([reportId, domainId])
  @@index([domainId, beginDate, endDate])
  @@index([organizationId, createdAt])
  @@map("dmarc_reports")
}

enum ReportType {
  AGGREGATE
  FORENSIC
}

enum PolicyP {
  NONE
  QUARANTINE
  REJECT
}

enum PolicySp {
  NONE
  QUARANTINE
  REJECT
}

model DmarcRecord {
  id           String @id @default(cuid())
  reportId     String @map("report_id")
  sourceIp     String @map("source_ip")
  sourceHost   String? @map("source_host")
  sourceOrg    String? @map("source_org")
  count        Int
  disposition  PolicyP
  dkimResult   DkimSpfResult @default(NEUTRAL) @map("dkim_result")
  spfResult    DkimSpfResult @default(NEUTRAL) @map("spf_result")
  dkimDomain   String? @map("dkim_domain")
  dkimSelector String? @map("dkim_selector")
  spfDomain    String? @map("spf_domain")
  headerFrom   String  @map("header_from")
  envelopeFrom String? @map("envelope_from")
  envelopeTo   String? @map("envelope_to")
  asn          Int?
  asnOrg       String?  @map("asn_org")
  country      String?
  city         String?
  latitude     Float?
  longitude    Float?
  reverseDns   String?  @map("reverse_dns")
  isForwarder  Boolean  @default(false) @map("is_forwarder")
  extra        Json     @default("{}")
  polished     Boolean  @default(false)

  report DmarcReport @relation(fields: [reportId], references: [id])

  @@index([sourceIp])
  @@index([reportId, spfResult, dkimResult])
  @@index([headerFrom])
  @@map("dmarc_records")
}

enum DkimSpfResult {
  PASS
  FAIL
  NEUTRAL
  TEMPERROR
  PERMERROR
  NONE
}

model DmarcDailySummary {
  id             String   @id @default(cuid())
  domainId       String   @map("domain_id")
  organizationId String   @map("organization_id")
  date           DateTime
  totalEmails    Int      @default(0) @map("total_emails")
  spfPass        Int      @default(0) @map("spf_pass")
  spfFail        Int      @default(0) @map("spf_fail")
  dkimPass       Int      @default(0) @map("dkim_pass")
  dkimFail       Int      @default(0) @map("dkim_fail")
  dmarcPass      Int      @default(0) @map("dmarc_pass")
  dmarcFail      Int      @default(0) @map("dmarc_fail")
  uniqueIps      Int      @default(0) @map("unique_ips")
  forwarders     Int      @default(0)
  spfAligned     Float    @default(0) @map("spf_aligned")
  dkimAligned    Float    @default(0) @map("dkim_aligned")
  healthScore    Float?   @map("health_score")
  topSenders     Json     @default("[]") @map("top_senders")
  topCountries   Json     @default("[]") @map("top_countries")
  topAsn         Json     @default("[]") @map("top_asn")

  domain       Domain       @relation(fields: [domainId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([domainId, date])
  @@index([organizationId, date])
  @@map("dmarc_daily_summaries")
}

// =============================================================================
// FORENSIC REPORTS (RUF) - Privacy-sensitive
// =============================================================================

model ForensicReport {
  id             String   @id @default(cuid())
  domainId       String   @map("domain_id")
  organizationId String   @map("organization_id")
  reportId       String   @unique @map("report_id")
  originalXml    String   @map("original_xml")
  sanitizedXml   String?  @map("sanitized_xml")
  subject        String?
  sourceIp       String?  @map("source_ip")
  arrivedDate    DateTime? @map("arrived_date")
  disposition    String?
  headers        Json     @default("{}")
  bodyTruncated  String?  @map("body_truncated")
  privacyLevel   String   @default("sanitized") @map("privacy_level")
  retained       Boolean  @default(true)
  retentionUntil DateTime? @map("retention_until")
  createdAt      DateTime @default(now()) @map("created_at")

  domain       Domain       @relation(fields: [domainId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([domainId, createdAt])
  @@map("forensic_reports")
}

// =============================================================================
// ALERTS
// =============================================================================

model Alert {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  domainId       String?   @map("domain_id")
  type           AlertType
  severity       Severity
  title          String
  description    String
  metadata       Json      @default("{}")
  acknowledged   Boolean   @default(false)
  acknowledgedBy String?   @map("acknowledged_by")
  resolved       Boolean   @default(false)
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  domain       Domain?       @relation(fields: [domainId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId, acknowledged, resolved])
  @@index([domainId, type])
  @@map("alerts")
}

enum AlertType {
  NEW_IP_DETECTED
  SPF_FAIL_SPIKE
  DKIM_FAIL_SPIKE
  DMARC_POLICY_CHANGED
  PROVIDER_STOPPED_SIGNING
  ALIGNMENT_LOST
  TRAFFIC_SPIKE
  POSSIBLE_SPOOFING
  SPF_LOOKUP_LIMIT_EXCEEDED
  DMARC_RECORD_INVALID
  DKIM_KEY_WEAK
  DKIM_KEY_EXPIRING
  NO_SPF_RECORD
  NO_DKIM_RECORD
  NO_DMARC_RECORD
  DNS_CHANGE_DETECTED
  TLS_RPT_FAILURE
  BIMI_INVALID
  MTA_STS_FAILURE
  CUSTOM
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

model NotificationRule {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  enabled        Boolean  @default(true)
  alertTypes     AlertType[]
  minSeverity    Severity @default(WARNING) @map("min_severity")
  channels       NotificationChannel[]
  config         Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("notification_rules")
}

enum NotificationChannel {
  EMAIL
  SLACK
  DISCORD
  TEAMS
  TELEGRAM
  WEBHOOK
  IN_APP
}

// =============================================================================
// INTEGRATIONS
// =============================================================================

model Integration {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  type           IntegrationType
  name           String
  config         Json
  encrypted      Boolean     @default(true)
  active         Boolean     @default(true)
  lastTestAt     DateTime?   @map("last_test_at")
  lastError      String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("integrations")
}

enum IntegrationType {
  SLACK
  DISCORD
  TEAMS
  TELEGRAM
  WEBHOOK
  PAGERDUTY
  OPSGENIE
  EMAIL
}

// =============================================================================
// THREAT INTELLIGENCE
// =============================================================================

model ThreatIntel {
  id        String   @id @default(cuid())
  domainId  String   @map("domain_id")
  ip        String
  source    String
  listed    Boolean
  details   Json     @default("{}")
  checkedAt DateTime @default(now()) @map("checked_at")

  domain Domain @relation(fields: [domainId], references: [id])

  @@unique([domainId, ip, source])
  @@index([ip])
  @@map("threat_intel")
}

// =============================================================================
// AUDIT LOGS
// =============================================================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  resource       String
  resourceId     String?  @map("resource_id")
  details        Json     @default("{}")
  ip             String?
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

// =============================================================================
// EXPORT JOBS
// =============================================================================

model ExportJob {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  userId         String     @map("user_id")
  type           ExportType
  format         ExportFormat
  status         ExportStatus @default(PENDING)
  filters        Json       @default("{}")
  fileUrl        String?    @map("file_url")
  error          String?
  completedAt    DateTime?  @map("completed_at")
  createdAt      DateTime   @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@map("export_jobs")
}

enum ExportType {
  DMARC_REPORT
  SUMMARY
  DNS_SNAPSHOT
  ALERTS
  FULL_EXPORT
}

enum ExportFormat {
  CSV
  JSON
  PDF
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
