{
  "name": "dmark-hole",
  "version": "2.0.0",
  "private": true,
  "description": "Self-hosted DMARC report receiver and analyzer (single container / LXC friendly)",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter @dmark-hole/server dev",
    "dev:web": "pnpm --filter @dmark-hole/web dev",
    "build": "pnpm --filter @dmark-hole/web build && pnpm --filter @dmark-hole/server build",
    "start": "node packages/server/dist/index.js",
    "test": "pnpm --filter @dmark-hole/server test",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
